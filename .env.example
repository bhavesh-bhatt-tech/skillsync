# Frontend configuration loaded automatically by Vite.
VITE_API_BASE_URL=http://localhost:5000/api

# Admin key must be provided by the host; Vite embeds VITE_* values at build/start time.
VITE_ADMIN_KEY=

# Used by Prisma and the Express backend; never expose these as VITE_* variables.
# Use __DATABASE_PASS__ only when constructing the URL from DATABASE_PASS.
DATABASE_URL="postgresql://user:__DATABASE_PASS__@your-neon-host/neondb?sslmode=require&channel_binding=require"
DATABASE_PASS=replace-with-your-database-password
PORT=5000
